  "figures": {
    "unique_publications_2025": {
      "metric": "is_unique_publication",
      "period": "2025",
      "format": "count",
      "numerator": 4800,
      "label": "Unique publications",
      "definition": "Journal articles and preprints without an associated journal article, published by grantees or authors at the foundation."
    },
    "compliance_2025": {
      "metric": "is_compliant_publication",
      "denominator_metric": "is_covered_by_policy",
      "period": "2025",
      "format": "percent",
      "numerator": 3761,
      "denominator": 4802,
      "label": "Policy compliance",
      "detail": "publications covered by the policy",
      "definition": "The percentage of publications covered by the foundation’s Open Access policy that are compliant with it."
    },
    "preprints_2025": {
      "metric": "is_preprint",
      "period": "2025",
      "format": "count",
      "numerator": 1999,
      "label": "Preprints",
      "definition": "Preprints published by grantees or authors at the foundation."
    },
    "preprints_lmic_2025": {
      "metric": "is_preprint AND authorships.institutions.country_code:(LMIC list)",
      "denominator_metric": "is_preprint AND authorships.institutions.country_code:*",
      "period": "2025",
      "format": "percent",
      "numerator": 1143,
      "denominator": 1824,
      "label": "Preprints with authors in low- and middle-income countries",
      "info": "1,143 of 1,824 preprints where author locations are known. Countries as classed by the World Bank for 2025–26.",
      "source": "Counted from the live API on 4 Nov 2026: preprints with at least one author institution in a low, lower-middle or upper-middle income country (World Bank FY2026, 130 countries incl. China). 175 preprints with no country data are left out."
    },
    "das_2025": {
      "metric": "has_data_availability_statement",
      "denominator_metric": "has_checked_data_availability_statement",
      "period": "2025",
      "format": "percent",
      "numerator": 2972,
      "denominator": 3911,
      "label": "Data availability statements",
      "detail": "reviewed journal articles",
      "definition": "The percentage of journal articles we’ve analysed that have a data availability statement."
    },
    "grant_linked_2025": {
      "metric": "is_unique_publication AND supplements.grantid__bmgf:*",
      "denominator_metric": "is_unique_publication",
      "period": "2025",
      "format": "percent",
      "numerator": 3313,
      "denominator": 4801,
      "label": "Publications linked to a grant",
      "detail": "publications matched to a specific Gates grant",
      "definition": "The percentage of unique publications with at least one Gates grant ID.",
      "source": "Counted from the live API on 4 Nov 2026. Steady at 68–73% each year since 2020."
    },
    "top_cited_2025": {
      "metric": "is_paper AND openalx.citation_normalized_percentile.is_in_top_10_percent:true",
      "denominator_metric": "is_paper AND openalx.citation_normalized_percentile.value:*",
      "period": "2025",
      "format": "percent",
      "numerator": 1623,
      "denominator": 3902,
      "label": "Articles in the top 10% most cited",
      "info": "1,623 of 3,902 articles, ranked by citations against others in the same field and year (OpenAlex).",
      "context": "Over four times the 10% you’d expect.",
      "source": "Counted from the live API on 4 Nov 2026 using OpenAlex’s citation_normalized_percentile. cited_by_percentile_year was not used: it puts any article with one citation in the top 10%."
    },
    "research_acceleration_2025": {
      "metric": "sum(journal published_date − preprint published_date) for 2025 journal articles with a preprint",
      "period": "2025",
      "format": "count",
      "numerator": 516,
      "label": "Years of research acceleration",
      "info": "The total time 2025 journal articles were available early as preprints: for each article, the gap between its earliest preprint and its journal publication, added up. Only preprints posted before the article count. For example, a preprint posted on 1 Jan 2024 and published in a journal on 1 Jan 2025 adds one year.",
      "source": "Calculated from the live API on 3 Nov 2026: 553 of 1,148 2025 journal articles with a linked preprint (supplements.is_preprint_of) had it posted first; gaps summed and divided by 365.25.",
      "method": "Paged GETs of is_preprint AND supplements.is_preprint_of:* and of 2025 is_paper; matched by DOI at build time",
      "status_note": "Superseded by head_start_* figures (1 Jan dates excluded)"
    },
    "head_start_median_2025": {
      "metric": "median(journal published_date − earliest preprint published_date)",
      "period": "2025",
      "format": "measure",
      "numerator": 7.6,
      "unit": "months",
      "label": "Median head start from preprinting",
      "info": "Median time between a preprint and its journal article, for the 435 articles published in 2025 that were preprinted first. Submission to publication uses the 382 of these with a submission date.",
      "source": "Calculated from the live API on 4 Nov 2026: 2025 journal articles matched to their earliest linked preprint (supplements.is_preprint_of); 435 were preprinted first. Preprints dated exactly 1 January (likely year-only dates) are left out.",
      "context": "Longer than the 6.5 months from submission to journal publication."
    },
    "head_start_total_2025": {
      "metric": "sum(journal published_date − earliest preprint published_date)",
      "period": "2025",
      "format": "measure",
      "numerator": 365,
      "unit": "years",
      "label": "Combined head start from preprinting",
      "info": "The head starts of the 435 articles published in 2025 that were preprinted first, added up.",
      "source": "Calculated from the live API on 4 Nov 2026: 2025 journal articles matched to their earliest linked preprint (supplements.is_preprint_of); 435 were preprinted first. Preprints dated exactly 1 January (likely year-only dates) are left out."
    }
  },
