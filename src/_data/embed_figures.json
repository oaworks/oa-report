    "unique_publications_2025": {
      "metric": "is_unique_publication",
      "period": "2025",
      "format": "count",
      "numerator": 4800,
      "label": "Unique publications",
      "definition": "Journal articles and preprints without an associated journal article, published by grantees or authors at the foundation."
    },
    "compliance_2025": {
      "metric": "is_compliant_publication",
      "denominator_metric": "is_covered_by_policy",
      "period": "2025",
      "format": "percent",
      "numerator": 3761,
      "denominator": 4802,
      "label": "Policy compliance",
      "detail": "publications covered by the policy",
      "definition": "The percentage of publications covered by the foundation’s Open Access policy that are compliant with it."
    },
    "preprints_2025": {
      "metric": "is_preprint",
      "period": "2025",
      "format": "count",
      "numerator": 1999,
      "label": "Preprints",
      "definition": "Preprints published by grantees or authors at the foundation."
    },
    "das_2025": {
      "metric": "has_data_availability_statement",
      "denominator_metric": "has_checked_data_availability_statement",
      "period": "2025",
      "format": "percent",
      "numerator": 2972,
      "denominator": 3911,
      "label": "Data availability statements",
      "detail": "reviewed journal articles",
      "definition": "The percentage of journal articles we’ve analysed that have a data availability statement."
    },
    "research_acceleration_2025": {
      "metric": "sum(journal published_date − preprint published_date) for 2025 journal articles with a preprint",
      "period": "2025",
      "format": "count",
      "numerator": 516,
      "label": "Years of research acceleration",
      "info": "The total time 2025 journal articles were available early as preprints: for each article, the gap between its earliest preprint and its journal publication, added up. Only preprints posted before the article count. For example, a preprint posted on 1 Jan 2024 and published in a journal on 1 Jan 2025 adds one year.",
      "source": "Calculated from the live API on 3 Nov 2026: 553 of 1,148 2025 journal articles with a linked preprint (supplements.is_preprint_of) had it posted first; gaps summed and divided by 365.25.",
      "method": "Paged GETs of is_preprint AND supplements.is_preprint_of:* and of 2025 is_paper; matched by DOI at build time"
    }
  },
