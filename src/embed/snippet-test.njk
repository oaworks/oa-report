---
eleventyExcludeFromCollections: true
---
{#- The literal snippet a client pastes, twice (GH#4005): a real org/type/
    metric combination, and a wrong one to check it fails silently. No
    doctype hacks, no server-rendered card — if this page works, the real
    pipeline works. -#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex, nofollow">
  <title>Embed snippet test</title>
</head>
<body>
  <h1>Tile</h1>
  <div 
    data-oareport-org="gates-foundation" 
    data-oareport-type="tile" 
    data-oareport-metric="is_unique_publication_2025">
  </div>

  <h1>Comparison</h1>
  <div 
    data-oareport-org="gates-foundation" 
    data-oareport-type="comparison" 
    data-oareport-metric="preprint_growth">
  </div>

  <h1>Headline</h1>
  <div 
    data-oareport-org="gates-foundation" 
    data-oareport-type="headline" 
    data-oareport-metric="compliance">
  </div>

  <h1>Trend</h1>
  <div 
    data-oareport-org="gates-foundation" 
    data-oareport-type="trend" 
    data-oareport-metric="preprint_share_percent">
  </div>

  <h1>Tile, linked to the org’s report instead of the landing page</h1>
  <div 
    data-oareport-org="gates-foundation" 
    data-oareport-type="tile" 
    data-oareport-metric="is_unique_publication_2025"
    data-oareport-link="report">
  </div>

  <h1>Tile, with Gates’ brand colour as the accent</h1>
  <div
    data-oareport-org="gates-foundation"
    data-oareport-type="tile"
    data-oareport-metric="is_unique_publication_2025"
    data-oareport-accent="#313A44">
  </div>

  <h1>Wrong metric (should show nothing; check the console for why)</h1>
  <div data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="does-not-exist"></div>

  <script src="/embed.js"></script>
</body>
</html>
