  <h1>Tile, with Gates’ brand colour as the accent</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="is_unique_publication_2025" data-oareport-accent="#313A44" async></script>
  <h2>Long form</h2>
  <div data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="is_unique_publication_2025" data-oareport-accent="#313A44"></div>
  <script src="/embed.js"></script>

  <h1>Wrong metric (should show nothing; check the console for why)</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="does-not-exist" async></script>
  <h2>Long form</h2>
  <div data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="does-not-exist"></div>
  <script src="/embed.js"></script>
