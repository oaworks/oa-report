{#- The literal snippet a client pastes, twice (GH#4005): a real org/type/
    metric combination, and a wrong one to check it fails silently. No
    doctype hacks, no server-rendered card — if this page works, the real
    pipeline works. -#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex, nofollow">
  <title>Embed snippet test</title>
</head>
<body>
  <h1>Tile</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="is_unique_publication_2025" async></script>
  <h2>Long form</h2>
  <div data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="is_unique_publication_2025"></div>
  <script src="/embed.js"></script>

  <h1>Comparison</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="comparison" data-oareport-metric="preprint_growth" async></script>
  <h2>Long form</h2>
  <div data-oareport-org="gates-foundation" data-oareport-type="comparison" data-oareport-metric="preprint_growth"></div>
  <script src="/embed.js"></script>

  <h1>Headline</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="headline" data-oareport-metric="compliance" async></script>
  <h2>Long form</h2>
  <div data-oareport-org="gates-foundation" data-oareport-type="headline" data-oareport-metric="compliance"></div>
  <script src="/embed.js"></script>

  <h1>Trend</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="trend" data-oareport-metric="preprint_share_percent" async></script>
  <h2>Long form</h2>
  <div data-oareport-org="gates-foundation" data-oareport-type="trend" data-oareport-metric="preprint_share_percent"></div>
  <script src="/embed.js"></script>

  <h1>Tile, linked to the org’s report instead of the landing page</h1>
  <h2>Short form</h2>
  <script src="/embed.js" data-oareport-org="gates-foundation" data-oareport-type="tile" data-oareport-metric="is_unique_publication_2025" data-oareport-link="report" async></script>
