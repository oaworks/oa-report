{% endraw %}{#- Our CSS comes after theirs so our Inter replaces their Inter, which is blocked cross-origin #}
<link rel="stylesheet" href="/tailwind.css">
{#- Their unlayered CSS beats our layered Tailwind, so inside embeds every property rolls back to our layers; inline-positioned chart labels are skipped #}
<style>.embed-root, .embed-root *:not([style]), .embed-root *::before, .embed-root *::after { all: revert-layer !important; }</style>
{#- Their Tailwind 3 sets the same --tw-* variables as our Tailwind 4 on every element, which breaks our transforms.
    “all” doesn’t cover variables, so inside embeds each shared one rolls back to our layers by name. #}
<style>.embed-root, .embed-root *, .embed-root *::before, .embed-root *::after { --tw-backdrop-blur: revert-layer !important; --tw-backdrop-brightness: revert-layer !important; --tw-backdrop-contrast: revert-layer !important; --tw-backdrop-grayscale: revert-layer !important; --tw-backdrop-hue-rotate: revert-layer !important; --tw-backdrop-invert: revert-layer !important; --tw-backdrop-opacity: revert-layer !important; --tw-backdrop-saturate: revert-layer !important; --tw-backdrop-sepia: revert-layer !important; --tw-blur: revert-layer !important; --tw-border-spacing-x: revert-layer !important; --tw-border-spacing-y: revert-layer !important; --tw-brightness: revert-layer !important; --tw-contain-layout: revert-layer !important; --tw-contain-paint: revert-layer !important; --tw-contain-size: revert-layer !important; --tw-contain-style: revert-layer !important; --tw-contrast: revert-layer !important; --tw-drop-shadow: revert-layer !important; --tw-gradient-from-position: revert-layer !important; --tw-gradient-to-position: revert-layer !important; --tw-gradient-via-position: revert-layer !important; --tw-grayscale: revert-layer !important; --tw-hue-rotate: revert-layer !important; --tw-invert: revert-layer !important; --tw-numeric-figure: revert-layer !important; --tw-numeric-fraction: revert-layer !important; --tw-numeric-spacing: revert-layer !important; --tw-ordinal: revert-layer !important; --tw-pan-x: revert-layer !important; --tw-pan-y: revert-layer !important; --tw-pinch-zoom: revert-layer !important; --tw-ring-color: revert-layer !important; --tw-ring-inset: revert-layer !important; --tw-ring-offset-color: revert-layer !important; --tw-ring-offset-shadow: revert-layer !important; --tw-ring-offset-width: revert-layer !important; --tw-ring-shadow: revert-layer !important; --tw-rotate: revert-layer !important; --tw-saturate: revert-layer !important; --tw-scale-x: revert-layer !important; --tw-scale-y: revert-layer !important; --tw-scroll-snap-strictness: revert-layer !important; --tw-sepia: revert-layer !important; --tw-shadow: revert-layer !important; --tw-shadow-colored: revert-layer !important; --tw-skew-x: revert-layer !important; --tw-skew-y: revert-layer !important; --tw-slashed-zero: revert-layer !important; --tw-translate-x: revert-layer !important; --tw-translate-y: revert-layer !important; }</style>
{#- Tailwind’s base reset also changes their page wherever their CSS relies on browser defaults.
    This later layer beats Tailwind’s layers, so outside the embeds and their slots everything goes back to browser defaults.
    Their own unlayered CSS still wins over it. #}
<style>@layer mockup-reset { html, body, body :not(.embed-root, .embed-root *, .mockup-slot, .mockup-slot *, svg, svg *), body :not(.embed-root, .embed-root *, .mockup-slot, .mockup-slot *, svg, svg *)::before, body :not(.embed-root, .embed-root *, .mockup-slot, .mockup-slot *, svg, svg *)::after, body :not(.embed-root, .embed-root *, .mockup-slot, .mockup-slot *, svg, svg *)::placeholder { all: revert; } }</style>
{#- “all: revert” also drops size and fill attributes, so their SVGs only get Tailwind’s two SVG resets undone #}
<style>@layer mockup-reset { body svg:not(.embed-root *, .mockup-slot *) { display: revert; vertical-align: revert; } }</style>
