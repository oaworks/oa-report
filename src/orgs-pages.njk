---
layout: layouts/base.njk
hideBaseHeader: true
pagination:
    data: orgs.hits.hits
    size: 1
    alias: org
permalink: "{{ org._source.objectID | slug }}/"
---

{%- from "system/component.njk" import component with context -%}

<a
  href="#main-content"
  class="fixed inset-x-0 top-0 z-[100] block -translate-y-full bg-carnation-700 px-4 py-3 text-center text-sm font-medium text-white shadow-lg transition-transform focus-visible:translate-y-0 focus-visible:outline-none"
>
  Skip to main content
</a>

{% block header %}
<div id="js-report-nav" class="bg-neutral-900 text-neutral-100 border-b border-neutral-700 lg:sticky top-0 z-50">
  {% include 'partials/header.njk' %}
</div>
{% endblock %}

<main id="main-content" tabindex="-1" class="bg-neutral-900 text-neutral-100">
  {% include 'partials/report/insights.njk' %}
  {% include 'partials/report/explore.njk' %}
  {% include 'partials/report/actions.njk' %}

  {# Dynamic modal #}
  <div id="dynamic-modal" class="fixed inset-0 flex items-center justify-center p-4 bg-neutral-900 bg-opacity-50 hidden z-50" aria-hidden="true" tabindex="-1" role="dialog" aria-modal="true">
    <div class="modal-content scale-95 transform overflow-y-auto min-h-0 max-h-[80vh] bg-neutral-900 text-neutral-100 shadow-lg md:w-1/3" role="document">
      <div class="flex items-center border-b border-neutral-700 bg-neutral-900 p-2">
        <div class="flex-grow text-xs font-semibold text-neutral-100 md:text-sm">
          <h2 class="modal-title text-center"><span class="sr-only">Dialog</span></h2>
        </div>
        <button class="close-modal-btn text-neutral-300 transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900">
          <span class="sr-only">Close modal</span>
          &times;
        </button>
      </div>
      <div class="modal-body p-3 text-xs font-light text-neutral-200 md:p-6 md:text-lg"></div>
    </div>
  </div>
</main>
