---
layout: layouts/base.njk
hideBaseHeader: true
pagination:
    data: orgs.hits.hits
    size: 1
    alias: org
permalink: "{{ org._source.objectID | slug }}/"
---

{%- from "system/component.njk" import component with context -%}

<a
  href="#main-content"
  class="fixed inset-x-0 top-0 z-[100] block -translate-y-full bg-carnation-700 px-4 py-3 text-center text-sm font-medium text-white shadow-lg transition-transform focus-visible:translate-y-0 focus-visible:outline-none"
>
  Skip to main content
</a>

{% block header %}
<div id="js-report-nav" class="sticky top-0 z-50 border-b border-neutral-200 bg-white text-neutral-900 lg:sticky">
  {% include 'partials/header.njk' %}
</div>
{% endblock %}

<main id="main-content" tabindex="-1" class="text-neutral-900">
  {% include 'partials/report/insights.njk' %}
  {% include 'partials/report/explore.njk' %}
  {% include 'partials/report/actions.njk' %}

  {# Dynamic modal #}
  <div id="dynamic-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-neutral-900/50 p-4" aria-hidden="true" tabindex="-1" role="dialog" aria-modal="true">
    <div class="modal-content min-h-0 max-h-[80vh] scale-95 transform overflow-y-auto bg-white text-neutral-900 shadow-lg md:w-1/3" role="document">
      <div class="flex items-center border-b border-neutral-200 bg-white p-2">
        <div class="flex-grow text-xs font-semibold text-neutral-900 md:text-sm">
          <h2 class="modal-title text-center"><span class="sr-only">Dialog</span></h2>
        </div>
        <button class="close-modal-btn text-neutral-500 transition-colors hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white">
          <span class="sr-only">Close modal</span>
          &times;
        </button>
      </div>
      <div class="modal-body p-3 text-xs font-light text-neutral-700 md:p-6 md:text-lg"></div>
    </div>
  </div>
</main>
