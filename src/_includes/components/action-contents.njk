{# Tab contents component: use with action-pill
{{ component("action-contents", {
  id: "",
  heading: "",
  desc: "",
  table_headings: "",
  draft_btn: false,
  copy_btn: false,
  hidden: true
}) }}
#}

<section class="grid grid-cols-12 gap-3 lg:gap-6 md:gap-12 js_strategy {% if params.hidden %} hidden{% else %}{% endif %}" id="{{ params.id }}"{% if params.hidden %} hidden{% else %}{% endif %}>
  <header class="md:mb-12 col-span-12 lg:col-span-4">
    <div class=" lg:sticky lg:top-3">
      <h3 class="mb-3 text-base font-semibold uppercase tracking-wide text-neutral-900 md:mb-6 md:text-lg">{{ params.heading }}</h3>
      <p class="mb-3 text-sm text-neutral-700 md:mb-6 md:text-base">{{ params.desc|safe }}</p>
      <form id="form_{{ params.id }}" onsubmit="return window.callGetActionExportLink('{{ params.id }}')">
        <h4 class="mb-2 text-sm font-semibold uppercase">Get this dataset in CSV</h4>
        <p class="mb-4 text-sm text-neutral-700">Download the list of <span class="rounded-full bg-white px-2 py-1 font-medium lowercase text-neutral-900 action_type">actions</span> for <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 font-medium text-neutral-900"><span class="report_readable_start_date min-w-0"></span> — <span class="report_readable_end_date min-w-0"></span></span></p>
        <label for="email-{{ params.id }}" class="sr-only">Email address</label>
        <div class="mt-1 mb-3 flex shadow-sm">
          <div class="relative flex grow items-stretch text-neutral-900 focus-within:z-10">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2 text-neutral-500">
              {% icon_small "envelope-simple" %}
            </div>
            <input type="email" name="email" id="email-{{ params.id }}" aria-describedby="email-hint-{{ params.id }}" autocomplete="email" class="block w-full border border-neutral-300 bg-white py-2 pl-10 text-neutral-900 focus:border-carnation-500 focus:ring-carnation-300 sm:text-sm" placeholder="you@example.com" required>
          </div>
          <button type="submit" class="--ml-px relative inline-flex items-center whitespace-nowrap border border-l-0 border-neutral-900 bg-neutral-900 px-2 py-2 text-sm font-medium text-white shadow-sm duration-500 hover:bg-neutral-800 focus:border-carnation-500 focus:outline-none focus:ring-1 focus:ring-carnation-300">
            <span>Get list of <span class="action_type">actions</span></span>
          </button>
        </div>
        <p id="email-hint-{{ params.id }}" class="mb-3 text-xs text-neutral-600">We’ll send the CSV link here.</p>
        <p class="leading-5 text-xs text-neutral-600" id="msg-{{ params.id }}" role="status" aria-live="polite" aria-atomic="true"></p>
      </form>
    </div>
  </header>
  <div class="col-span-12 lg:col-span-8 border-t pt-3 sm:pt-0 sm:border-0">
    <div
      id="action_table_controls_{{ params.id }}"
      role="toolbar"
      aria-label="Table controls"
      class="my-6 flex flex-wrap items-center justify-between gap-3 text-xs font-semibold uppercase text-neutral-600"
    >
      <p class="flex items-center gap-1.5" aria-live="polite">
        <span id="total_{{ params.id }}">00</span>
        <span>actions shown</span>
        {% if params.action_help_txt %}
        {{ component("tooltip", {
          sup: true,
          msg: "<p class='mb-2'>We tried to remove common errors and publications that are already in a repository (either embargoed or available). This list was produced using Unpaywall, Crossref, and ShareYourPaper Permissions data.</p>"
        }) }}
        {% endif %}
      </p>
      {% if params.copy_btn %}
      {{ component("copy-btn", {
        id: "copy_clipboard_" ~ params.id,
        label: "Copy article links"
      }) }}
      {% endif %}
    </div>
    <div class="overflow-x-auto rounded-lg border border-neutral-200 bg-white">
      <table class="border-separate border-spacing-0 table-fixed w-full bg-transparent" id="table_{{ params.id }}">
        <thead class="border-b border-neutral-200 bg-neutral-200 text-left text-xs font-medium uppercase tracking-wider text-neutral-900">
          <tr class="divide-x divide-neutral-300">
            {{ params.table_headings|safe }}
            {% if params.draft_btn %}<th scope='col' class='p-3 w-2/12'>Open draft {{ component('tooltip', {    msg: 'This will open a preset message in your email client. If you make any changes to the email, it will not be saved here.'  }) }}</th>{% endif %}
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200 bg-white text-neutral-900"></tbody>
      </table>
    </div>
  </div>
</section>
