{# Shared table-control copy button component
{{ component("copy-btn", {
  id: "",
  label: ""
}) }}
#}

{% set buttonClasses = "group flex items-center border-l border-neutral-700 p-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-1 focus-visible:ring-offset-neutral-900" %}
{% set chipClasses = "inline-flex items-center gap-1.5 rounded-sm border border-neutral-500 bg-neutral-800 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-neutral-100 shadow-sm transition-colors group-hover:border-neutral-300 group-hover:bg-neutral-700 group-hover:text-white group-focus-visible:border-neutral-300 group-focus-visible:bg-neutral-700 group-focus-visible:text-white [&>i]:shrink-0 [&>i]:text-[1em]" %}

<button id="{{ params.id }}" class="{{ buttonClasses }}">
  <span class="{{ chipClasses }}">
    <span aria-hidden="true">{% icon_small "clipboard" %}</span>
    <span data-copy-label>{{ params.label }}</span>
  </span>
</button>
