{# Shared table-control copy button component
{{ component("copy-btn", {
  id: "",
  label: ""
}) }}
#}

{% set buttonClasses = "group inline-flex items-center self-start focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white" %}
{% set chipClasses = "inline-flex items-center gap-1.5 rounded-sm border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-neutral-700 transition-colors group-hover:border-neutral-400 group-hover:bg-neutral-100 group-hover:text-neutral-900 group-focus-visible:border-neutral-400 group-focus-visible:bg-neutral-100 group-focus-visible:text-neutral-900 [&>i]:shrink-0 [&>i]:text-[1em]" %}

<button id="{{ params.id }}" class="{{ buttonClasses }}">
  <span class="{{ chipClasses }}">
    <span aria-hidden="true">{% icon_small "clipboard" %}</span>
    <span data-copy-label>{{ params.label }}</span>
  </span>
</button>
