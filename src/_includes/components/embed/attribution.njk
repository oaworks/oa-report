{# Embed footer: data date on the left, OA.Report logo link on the right.
   altUrl, when given, is exposed as data-report-url so the loader can swap
   the link to it client-side (see embed/loader.js), per a
   data-oareport-link="report" setting on the snippet’s placeholder div.
{{ component("embed/attribution", {
  url: "",
  altUrl: "",
  asOf: "YYYY-MM-DD"
}) }}
#}

<footer class="mt-4 flex items-center justify-between gap-3 border-t border-neutral-200 pt-3 text-xs text-neutral-700">
  <p class="whitespace-nowrap">As of <time datetime="{{ params.asOf }}">{{ params.asOf | date("d LLL yyyy") }}</time></p>
  <a href="{{ params.url }}" {% if params.altUrl %}data-report-url="{{ params.altUrl }}"{% endif %} target="_blank" rel="noopener" title="Powered by OA.Report" aria-label="Powered by OA.Report (opens in a new tab)" class="inline-flex w-20 shrink-0 translate-y-px [&>svg]:pointer-events-none text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--embed-accent)">
    {% include 'svg/logo.svg' %}
  </a>
</footer>
