{# Trend embed: one or more lines year by year, with an optional policy marker
{{ component("embed/trend", {
  id: "preprint_share",
  trend: embed_figures.trends.preprint_share,
  org: embed_figures.org,
  asOf: embed_figures.source.retrieved,
  headingLevel: 2
}) }}
#}
{%- from "system/component.njk" import component -%}

{% set trend = params.trend %}
{% set accent = params.accent or params.org.accent %}
{% set titleId = "embed_title_" ~ params.id %}
{% set periodLabel = trend.period | dateRange %}
{% set comparedWith = (trend.period | comparedWith(trend.comparison_period)) if trend.comparison_period else trend.compared_with %}
{% set styles = {
  accent: { stroke: "stroke-(--embed-accent)", fill: "fill-(--embed-accent)" },
  muted:  { stroke: "stroke-neutral-500", fill: "fill-neutral-500" }
} %}

{# Chart geometry in viewBox units; the y-axis starts at 0 so changes aren’t exaggerated #}
{% set multi = trend.lines.length > 1 %}
{% set W = 352 %}{% set H = 96 %}{% set padL = 6 %}{% set padR = 72 if multi else 6 %}{% set padTop = 20 %}{% set padBottom = 6 %}
{% set top = 0 %}
{% set lines = [] %}
{% set ends = [] %}
{% set allPts = [] %}
{% for line in trend.lines %}
  {% set vals = [] %}
  {% for p in line.points %}
    {% set v = ((p.numerator / p.denominator) * 100) if trend.format == "percent" else p.numerator %}
    {% set vals = (vals.push(v), vals) %}
    {% if v > top %}{% set top = v %}{% endif %}
  {% endfor %}
  {% set lines = (lines.push({ line: line, vals: vals }), lines) %}
{% endfor %}
{% set magnitude = 10 if trend.format == "percent" else 500 %}
{% set yMax = (top / magnitude) | round(0, "ceil") * magnitude %}
{% set step = (W - padL - padR) / (trend.categories.length - 1) %}

<article
  aria-labelledby="{{ titleId }}"
  class="embed-root flex w-full max-w-sm flex-col rounded-sm border border-t-4 border-neutral-200 border-t-(--embed-accent) bg-white p-4 font-sans text-base leading-normal tracking-normal text-neutral-900"
  {% if accent %}style="--embed-accent: {{ accent }};"{% endif %}>
  {{ component("embed/header", { id: titleId, org: params.org.name, period: periodLabel, note: comparedWith if trend.comparison_period, level: params.headingLevel }) }}

  {% if trend.hero %}
    <dl class="mt-5">
      {{ component("embed/change-figure", { figure: trend.hero, comparedWith: comparedWith }) }}
    </dl>
  {% endif %}
  {% if trend.rows %}
    <dl class="mt-5 space-y-2">
      {% for f in trend.rows %}
        {{ component("embed/change-figure", { figure: f, comparedWith: comparedWith, compact: true }) }}
      {% endfor %}
    </dl>
  {% endif %}

  {# Decorative: the visually hidden table below carries the same data #}
  <div class="mt-4 rounded-xs bg-neutral-50 px-2 pb-1.5 pt-2" aria-hidden="true">
    {% if trend.note %}<p class="mb-1 text-xs text-neutral-700">{{ trend.note }}</p>{% endif %}
    <div class="relative">
      {% for c in trend.categories %}
        {% if c == trend.policy_start %}
          <span class="absolute top-0 -translate-x-1/2 text-xs text-neutral-700" style="left: {{ ((padL + loop.index0 * step) / W * 100) | round(2) }}%;">Policy</span>
        {% endif %}
      {% endfor %}
      <svg viewBox="0 0 {{ W }} {{ H }}" class="block h-auto w-full" focusable="false">
        {% for c in trend.categories %}
          {% if c == trend.policy_start %}
            {% set px = (padL + loop.index0 * step) | round(1) %}
            <line x1="{{ px }}" y1="{{ padTop - 2 }}" x2="{{ px }}" y2="{{ H - padBottom }}" class="stroke-neutral-300" stroke-width="1" stroke-dasharray="3 3"/>
          {% endif %}
        {% endfor %}
        {% for l in lines %}
          {% set s = styles[l.line.style] or styles.accent %}
          {% set pts = [] %}
          {% for v in l.vals %}
            {% set pts = (pts.push({ x: (padL + loop.index0 * step) | round(1), y: (padTop + (1 - v / yMax) * (H - padTop - padBottom)) | round(1), partial: l.line.points[loop.index0].partial }), pts) %}
          {% endfor %}
          {% set solid = [] %}
          {% for pt in pts %}{% if not pt.partial %}{% set solid = (solid.push(pt.x ~ "," ~ pt.y), solid) %}{% endif %}{% endfor %}
          <polyline points="{{ solid | join(' ') }}" fill="none" class="{{ s.stroke }}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
          {% for pt in pts %}
            {% if pt.partial %}
              {% set prevPt = pts[loop.index0 - 1] %}
              <line x1="{{ prevPt.x }}" y1="{{ prevPt.y }}" x2="{{ pt.x }}" y2="{{ pt.y }}" class="{{ s.stroke }}" stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round"/>
              <circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="3" class="fill-white {{ s.stroke }}" stroke-width="2"/>
            {% else %}
              <circle cx="{{ pt.x }}" cy="{{ pt.y }}" r="3" class="{{ s.fill }}"/>
            {% endif %}
          {% endfor %}
          {% set lastPt = pts[pts.length - 1] %}
          {% set ends = (ends.push({ label: l.line.label, x: lastPt.x, y: lastPt.y, i: pts.length - 1, li: loop.index0 }), ends) %}
          {% set allPts = (allPts.push(pts), allPts) %}
        {% endfor %}
      </svg>
      {# Lines are named at their ends, so colour is never the only way to tell them apart #}
      {% if multi %}
        {% set lastX = 0 %}
        {% for e in ends %}{% if e.x > lastX %}{% set lastX = e.x %}{% endif %}{% endfor %}
        {% for e in ends %}
          {# A line that stops early is labelled on the side away from the longer line, so they don’t overlap #}
          {% set other = allPts[1 - e.li][e.i] if allPts.length == 2 %}
          {% if e.x >= lastX %}
            {% set placement = "-translate-y-1/2 pl-1.5" %}
          {% elif other and other.y < e.y %}
            {% set placement = "pl-1.5 pt-0.5" %}
          {% else %}
            {% set placement = "-translate-x-1/2 -translate-y-full pb-1" %}
          {% endif %}
          <span class="absolute whitespace-nowrap text-xs font-semibold text-neutral-800 {{ placement }}" style="left: {{ (e.x / W * 100) | round(2) }}%; top: {{ (e.y / H * 100) | round(2) }}%;">{{ e.label }}</span>
        {% endfor %}
      {% endif %}
    </div>
    <div class="mt-1 flex justify-between text-xs text-neutral-700" style="padding-right: {{ (padR / W * 100) | round(2) }}%;">
      <span>{{ trend.categories[0] }}</span>
      {% set lastPt = trend.lines[0].points[trend.lines[0].points.length - 1] %}
      <span>{{ trend.categories[trend.categories.length - 1] }}{% if not multi and lastPt.partial %} so far{% endif %}</span>
    </div>
  </div>

  <table class="sr-only">
    <caption>{{ trend.caption }}</caption>
    <thead>
      <tr>
        <th scope="col">Year</th>
        {% for l in trend.lines %}<th scope="col">{{ l.label }}</th>{% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for c in trend.categories %}
        {% set i = loop.index0 %}
        <tr>
          <th scope="row">{{ c }}{% if c == trend.policy_start %} (policy starts){% endif %}</th>
          {% for l in lines %}
            {% set p = l.line.points[i] %}
            <td>
              {% if p %}
                {{ (l.vals[i] | round ~ "%") if trend.format == "percent" else (l.vals[i] | number) }}{% if p.partial %} (so far){% endif %}
              {% else %}
                Not available yet
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {# Spacer keeps the footer at the bottom when cards share a row height #}
  <div class="grow" aria-hidden="true"></div>
  {{ component("embed/attribution", { url: params.org.report_url, asOf: params.asOf }) }}
</article>
