{# Story embed: how well a policy is working, as a share (or hero figure) plus supporting figures
{{ component("embed/story", {
  id: "policy_first_year",
  story: embed_figures.stories.policy_first_year,
  org: embed_figures.org,
  asOf: embed_figures.source.retrieved,
  headingLevel: 2
}) }}
#}
{%- from "system/component.njk" import component -%}

{% set story = params.story %}
{% set accent = params.accent or params.org.accent %}
{% set comparedWith = story.period | comparedWith(story.comparison_period) %}
{% set titleId = "embed_title_" ~ params.id %}
{% set periodLabel = story.period | dateRange %}
{% set share = story.share %}
{% if share %}{% set sharePct = (share.current.numerator / share.current.denominator) * 100 %}{% endif %}

<article
  aria-labelledby="{{ titleId }}"
  class="embed-root flex w-full max-w-sm flex-col rounded-sm border border-t-4 border-neutral-200 border-t-(--embed-accent) bg-white p-4 font-sans text-base leading-normal tracking-normal text-neutral-900"
  {% if accent %}style="--embed-accent: {{ accent }};"{% endif %}>
  {% set note = comparedWith ~ ((", " ~ story.comparison_note) if story.comparison_note else "") %}
  {{ component("embed/header", { id: titleId, org: params.org.name, period: periodLabel, note: note, level: params.headingLevel }) }}

  {% if share %}
    <div class="mt-5 flex items-center gap-4">
      {# Decorative: the figure and label beside it carry the same information #}
      <svg viewBox="-1 -1 38 38" class="size-20 shrink-0 -rotate-90" aria-hidden="true" focusable="false">
        <circle cx="18" cy="18" r="15.9155" fill="none" stroke-width="5" class="stroke-neutral-200"/>
        <circle cx="18" cy="18" r="15.9155" fill="none" stroke-width="5" class="stroke-(--embed-accent)" stroke-dasharray="{{ sharePct | round(1) }} 100"/>
      </svg>
      <dl>
        {{ component("embed/change-figure", { figure: share, comparedWith: comparedWith }) }}
      </dl>
    </div>
  {% else %}
    {# No share to chart: the hero figure stands alone #}
    <dl class="mt-5">
      {{ component("embed/change-figure", { figure: story.hero, comparedWith: comparedWith }) }}
    </dl>
  {% endif %}

  <dl class="mt-5 space-y-2">
    {% for f in story.figures %}
      {{ component("embed/change-figure", { figure: f, comparedWith: comparedWith, compact: true }) }}
    {% endfor %}
  </dl>

  {# Spacer keeps the footer at the bottom when cards share a row height #}
  <div class="grow" aria-hidden="true"></div>
  {{ component("embed/attribution", { url: params.org.report_url, asOf: params.asOf }) }}
</article>
