{# Headline embed: how well a policy is working, as a share (or hero figure) plus supporting figures
{{ component("embed/headline", {
  id: "policy_first_year",
  headline: embed_figures.headlines.policy_first_year,
  org: embed_figures.org,
  asOf: embed_figures.source.retrieved,
  headingLevel: 2
}) }}
#}
{%- from "system/component.njk" import component -%}

{% set headline = params.headline %}
{% set accent = params.accent or params.org.accent %}
{# The comparison is optional: without one, figures show no change #}
{% set comparedWith = (headline.period | comparedWith(headline.comparison_period)) if headline.comparison_period else "" %}
{% set titleId = "embed_title_" ~ params.id %}
{% set periodLabel = headline.period | dateRange %}
{% set share = headline.share %}
{% if share %}{% set sharePct = (share.current.numerator / share.current.denominator) * 100 %}{% endif %}

<article
  aria-labelledby="{{ titleId }}"
  class="embed-root flex w-full max-w-sm flex-col rounded-sm border border-t-4 border-neutral-200 border-t-(--embed-accent) bg-white p-4 font-sans text-base leading-normal tracking-normal text-neutral-900"
  {% if accent %}style="--embed-accent: {{ accent }};"{% endif %}>
  {% set note = comparedWith ~ ((", " ~ headline.comparison_note) if headline.comparison_note else "") %}
  {{ component("embed/header", { id: titleId, org: params.org.name, period: periodLabel, note: note, level: params.headingLevel }) }}

  {% if share %}
    <div class="mt-5 flex items-center gap-4">
      {# Decorative: the figure and label beside it carry the same information #}
      <svg viewBox="-1 -1 38 38" class="size-20 shrink-0 -rotate-90" aria-hidden="true" focusable="false">
        <circle cx="18" cy="18" r="15.9155" fill="none" stroke-width="5" class="stroke-neutral-200"/>
        {% if share.parts %}
          {# One arc per part; the circle’s length is 100, so each arc’s length is its percentage #}
          {% set total = share.current.denominator %}{% set offset = 0 %}
          {% set strokes = { accent: "stroke-(--embed-accent)", muted: "stroke-neutral-500", light: "stroke-neutral-300" } %}
          {% for part in share.parts %}
            {% set pct = (part.numerator / total) * 100 %}
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke-width="5" class="{{ strokes[part.swatch] }}" stroke-dasharray="{{ pct | round(1) }} 100" stroke-dashoffset="{{ (0 - offset) | round(1) }}"/>
            {% set offset = offset + pct %}
          {% endfor %}
        {% else %}
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke-width="5" class="stroke-(--embed-accent)" stroke-dasharray="{{ sharePct | round(1) }} 100"/>
        {% endif %}
      </svg>
      <dl>
        {{ component("embed/change-figure", { figure: share, comparedWith: comparedWith, id: params.id ~ "_share" }) }}
      </dl>
    </div>
  {% else %}
    {# No share to chart: the hero figure stands alone #}
    <dl class="mt-5">
      {{ component("embed/change-figure", { figure: headline.hero, comparedWith: comparedWith, id: params.id ~ "_hero" }) }}
    </dl>
  {% endif %}

  <dl class="mt-5 space-y-2">
    {% for f in headline.figures %}
      {{ component("embed/change-figure", { figure: f, comparedWith: comparedWith, compact: true, swatch: f.swatch, id: params.id ~ "_" ~ loop.index0 }) }}
    {% endfor %}
  </dl>

  {# Spacer keeps the footer at the bottom when cards share a row height #}
  <div class="grow" aria-hidden="true"></div>
  {{ component("embed/attribution", { url: params.org.report_url, asOf: params.asOf }) }}
</article>
