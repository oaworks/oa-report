{# Tooltip component
{{ component("tooltip", {
  sup: false,
  msg: "",
  id: "",
  label: "",
  text: ""
}) }}
#}

{% if params.sup %}
<sup 
  class="tooltip" 
  tabindex="0" 
  data-tooltip-content="{{ params.msg }}"
  data-tooltip-theme="{{ params.theme or 'tooltip-dark' }}"
  {% if params.id %} id="{{ params.id }}"{% endif %} 
  aria-label="
    {% if params.label %}
      {{ params.label }}
    {% else %}
      More information
    {% endif %}
  "
>
  {% if params.text %}
    <span class="border border-neutral-500 px-1 py-0.5 text-xs font-semibold uppercase transition duration-300 ease-in-out hover:bg-neutral-100 hover:text-neutral-900">{{ params.text }}</span>
  {% else %}
    <span class="rounded-full border border-neutral-500 px-1 py-0.5 text-xs font-semibold uppercase transition duration-300 ease-in-out hover:bg-neutral-100 hover:text-neutral-900">?</span>
  {% endif %}
</sup>
{% else %}
<span 
  class="tooltip" 
  tabindex="0" 
  data-tooltip-content="{{ params.msg }}"
  data-tooltip-theme="{{ params.theme or 'tooltip-dark' }}"
  {% if params.id %} id="{{ params.id }}"{% endif %} 
  aria-label="
    {% if params.label %}
      {{ params.label }}
    {% else %}
      More information
    {% endif %}
  "
>
  {{ params.text | safe }}
</span>
{% endif %}
