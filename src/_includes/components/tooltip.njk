{# Tooltip component
{{ component("tooltip", {
  sup: false,
  msg: "",
  id: "",
  label: "",
  text: "",
  trigger: "click"
}) }}
Click-triggered (a dialog) by default; pass trigger: "hover" for a true hover/focus tooltip.
#}

{% from "components/tooltip-trigger-icon.njk" import triggerIconClasses %}
{% set triggerClasses = "tooltip " + triggerIconClasses() + " rounded-sm" %}

{% if params.sup %}
<sup
  class="{{ triggerClasses }}"
  tabindex="0"
  data-tooltip-content="{{ params.msg }}"
  data-tooltip-theme="{{ params.theme or 'tooltip-light' }}"
  {% if params.trigger != "hover" %} data-tooltip-trigger="click"{% endif %}
  {% if params.id %} id="{{ params.id }}"{% endif %}
  aria-label="
    {% if params.label %}
      {{ params.label }}
    {% else %}
      More information
    {% endif %}
  "
>
  {% if params.text %}
    <span class="border border-neutral-500 px-1 py-0.5 text-xs font-semibold uppercase transition duration-300 ease-in-out hover:bg-neutral-100 hover:text-neutral-900">{{ params.text }}</span>
  {% else %}
    {% icon_small "info" %}
  {% endif %}
</sup>
{% else %}
<span
  class="{{ triggerClasses }}"
  tabindex="0"
  data-tooltip-content="{{ params.msg }}"
  data-tooltip-theme="{{ params.theme or 'tooltip-light' }}"
  {% if params.trigger != "hover" %} data-tooltip-trigger="click"{% endif %}
  {% if params.id %} id="{{ params.id }}"{% endif %}
  aria-label="
    {% if params.label %}
      {{ params.label }}
    {% else %}
      More information
    {% endif %}
  "
>
  {% if params.text %}
    {{ params.text | safe }}
  {% else %}
    {% icon_small "info" %}
  {% endif %}
</span>
{% endif %}
