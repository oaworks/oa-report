{# Card component (to be used for a single piece of data)
{{ component("card", {
  id: "",
  title: ""
}) }}
#}
{% from "components/info-trigger-icon.njk" import triggerIconClasses %}

<article
  id="{{ params.id }}"
  class="
    {% if params.projected %}border-dashed border-neutral-500 bg-neutral-850
    {% else %}border-neutral-700 bg-neutral-800{% endif %}
    rounded-md border shadow-sm proportional-card flex flex-col min-h-[120px] transition duration-200 ease-in-out
    hover:border-neutral-500 hover:bg-neutral-750 hover:shadow-md hover:-translate-y-0.5
    focus-within:border-neutral-500 focus-within:bg-neutral-750 focus-within:shadow-md focus-within:-translate-y-0.5
  "
>
  <div class="block w-full h-full p-3 text-left">
  <div class="flex items-stretch h-full gap-4">
    {# Vertical bar chart on the left. Keep in sync with INSIGHT_BAR_TRACK_BASE_CLASSES in utils.js. #}
    <footer
      class="
        js_bar_chart
        flex flex-col justify-end
        h-auto w-2
        bg-neutral-600
        rounded-full
        overflow-hidden
      "
      aria-hidden="true"
    ></footer>

    <div class="flex-1 min-w-0 flex flex-col">
      <div class="flex flex-col justify-between flex-1">
        {# Header: name of Insight and icon #}
        <header class="mb-3 flex items-start justify-between text-neutral-200">
          <h4 id="{{ params.id }}_title" class="text-sm font-medium inline-flex items-center cursor-text">
            <span class="inline-flex items-center">{{ params.title }}</span>
          </h4>
          <button
            type="button"
            class="js_insight_trigger {{ triggerIconClasses() }} shrink-0 p-0 m-0 ml-1 leading-none focus-visible:ring-offset-1 focus-visible:ring-offset-neutral-800 cursor-pointer"
            aria-expanded="false"
            aria-label="More information about the {{ params.title }} metric"
            title="More information on this metric"
          >
            {% icon_small "info" %}
          </button>
        </header>

        {# Body aligned to bottom #}
        <div class="flex items-end flex-1">
          <div class="self-end cursor-text text-white">
            <p class="text-xl font-bold leading-none" aria-live="polite">
              <span id="percent_{{ params.id }}">
                00%
              </span>
              {% if params.projected %}
                <sup class="js_projected_marker align-middle text-xs font-semibold normal-case text-neutral-300">(proj.)</sup>
              {% endif %}
            </p>
            <p class="sr-only mt-1 text-xs font-semibold text-neutral-400" aria-live="polite">
              <span id="articles_{{ params.id }}">
                articles
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</article>
