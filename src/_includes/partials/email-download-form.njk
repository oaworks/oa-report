{# Download in CSV #}
<form id="download_csv_form" onsubmit="return window.getExportLink()">
  <h4 class="mb-2 text-sm font-semibold uppercase">Get this dataset in CSV</h4>
  <p class="mb-4 text-sm text-neutral-700">Download the list of <span class="rounded-full bg-white px-2 py-1 font-medium lowercase text-neutral-900 explore_filter">all articles</span> for <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 font-medium text-neutral-900"><span class="report_readable_start_date min-w-0"></span> — <span class="report_readable_end_date min-w-0"></span></span> sorted by <span class="rounded-full bg-white px-2 py-1 font-medium text-neutral-900 explore_sort">publication count</span></p>
  <label for="email" class="sr-only">Email address</label>
  <div class="mt-1 mb-3 flex shadow-sm lg:w-1/3">
    <div class="relative flex items-stretch flex-grow focus-within:z-10">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2 text-neutral-500">
        {% icon_small "envelope-simple" %}
      </div>
      <input type="email" name="email" id="email" aria-describedby="csv-email-hint" autocomplete="email" class="block w-full border border-neutral-300 bg-white py-2 pl-10 text-neutral-900 focus:border-carnation-500 focus:ring-carnation-300 sm:text-sm" placeholder="you@example.com" required>
    </div> 
    <button type="submit" class="--ml-px relative inline-flex items-center whitespace-nowrap border border-l-0 border-neutral-900 bg-neutral-900 px-2 py-2 text-sm font-medium text-white shadow-sm duration-500 hover:bg-neutral-800 focus:border-carnation-500 focus:outline-none focus:ring-1 focus:ring-carnation-300">
      <span>Get all <span class="lowercase explore_type">articles</span></span>
    </button>
  </div>
  <p id="csv-email-hint" class="mb-3 text-xs text-neutral-600">We’ll send the CSV link here.</p>
  <p class="leading-5 text-xs text-neutral-600" id="csv_email_msg" role="status" aria-live="polite" aria-atomic="true"></p>
</form>
