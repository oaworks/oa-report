{# Explore section #}
{% from "partials/report/section-wrapper.njk" import sectionWrapper %}

{% call sectionWrapper("explore", "Explore") %}
  {# Breakdown table options #}
  <nav aria-label="Explore views" aria-labelledby="explore-nav-title" class="flex flex-wrap items-center gap-2 p-2 rounded-md bg-neutral-800/90 border border-neutral-700 shadow-lg">
    <h3 id="explore-nav-title" class="sr-only">Explore views</h3>
    <ul id="explore_buttons" class="flex flex-wrap items-center gap-4 m-0 p-0 list-none">
      <li id="explore_see_more_item" class="list-none">
        <button class="inline-flex items-center px-4 py-1.5 rounded-md bg-neutral-700 text-white text-sm font-medium hover:bg-neutral-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-1 focus-visible:ring-offset-neutral-800 transition-colors">
          <span>See more</span>
        </button>
      </li>
    </ul>
  </nav>

  <div class="mt-2 md:mt-4 bg-neutral-800 border border-neutral-700 shadow-lg rounded-lg p-4 md:p-6">
    {# Loading spinner #}
    <div
      class="fixed inset-0 z-50 flex justify-center items-center opacity-0 transition-opacity duration-300"
      id="explore_loading"
      aria-live="polite"
      aria-busy="true"
      >
      <div class="absolute inset-0 bg-neutral-900 bg-opacity-50"></div>
      <div class="loader ease-linear rounded-full border-8 border-t-8 border-carnation-200 border-t-carnation-500 h-12 w-12 z-10"></div>
      {# Visually hidden text for screen readers #}
      <div class="sr-only" id="loading_message">Loading, please wait.</div>
    </div>

    <div id="export_table">
      <header class="mb-4">
        <h3 class="mb-3 text-base md:text-lg font-semibold uppercase tracking-wide text-neutral-100" aria-live="polite">
          <span class="inline-flex items-center gap-2">
            <i class="ph ph-note text-[18px] leading-none js-explore-heading-icon" aria-hidden="true"></i>
            <span class="report_sort_adjective">Top</span>
            <strong class="uppercase font-semibold explore_type">articles</strong>
          </span>
        </h3>
      </header>
      {# Filter by buttons styled as tabs #}
      <div id="explore_filter_field" class="mt-4">
        <div
          id="explore_filters"
          role="tablist"
          aria-label="Explore data views"
          aria-orientation="horizontal"
          class="flex flex-wrap items-end gap-x-2 gap-y-2 border-neutral-700"
        ></div>
      </div>
      <div id="explore_view_panel" role="tabpanel" aria-labelledby="filter_is_paper">
        <div
          id="export_table_controls"
          role="toolbar"
          aria-label="Table controls"
          class="flex flex-wrap items-stretch justify-between border border-neutral-700 bg-neutral-900 text-xs font-semibold uppercase text-white"
        >
        <div class="flex flex-wrap items-stretch divide-x divide-neutral-700">
          <p id="explore_count_summary" class="flex items-center gap-1 p-3" aria-live="polite">
            <span id="explore_records_shown" class="inline-flex items-baseline"></span>
            / <span id="explore_count_total">0</span>
            <span id="explore_count_label">journal articles</span>
          </p>
          <form id="explore_display_style_field">
            <fieldset class="p-3">
              <legend class="sr-only">Display values as</legend>
              <div class="inline-flex rounded-sm border border-neutral-700 bg-neutral-800/70 p-0.5">
                <input
                  id="display-style-percent"
                  type="radio"
                  name="explore-display-style"
                  value="percent"
                  class="sr-only peer/display-percent"
                  checked
                >
                <label
                  for="display-style-percent"
                  class="inline-flex items-center gap-1 rounded-sm px-3 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-300 transition-colors hover:bg-neutral-700 hover:text-white peer-checked/display-percent:bg-neutral-100 peer-checked/display-percent:text-neutral-900 peer-focus-visible/display-percent:ring-2 peer-focus-visible/display-percent:ring-carnation-400 peer-focus-visible/display-percent:ring-offset-1 peer-focus-visible/display-percent:ring-offset-neutral-900 [&>i]:text-[1em]"
                >
                  Percent <span aria-hidden="true">{% icon_small "percent" %}</span>
                </label>
                <input
                  id="display-style-count"
                  type="radio"
                  name="explore-display-style"
                  value="count"
                  class="sr-only peer/display-count"
                >
                <label
                  for="display-style-count"
                  class="inline-flex items-center gap-1 rounded-sm px-3 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-300 transition-colors hover:bg-neutral-700 hover:text-white peer-checked/display-count:bg-neutral-100 peer-checked/display-count:text-neutral-900 peer-focus-visible/display-count:ring-2 peer-focus-visible/display-count:ring-carnation-400 peer-focus-visible/display-count:ring-offset-1 peer-focus-visible/display-count:ring-offset-neutral-900 [&>i]:text-[1em]"
                >
                  Count <span aria-hidden="true">{% icon_small "hash" %}</span>
                </label>
              </div>
            </fieldset>
          </form>
        </div>
        <button
          id="explore_copy_clipboard"
          class="flex items-center gap-1 p-3 border-l border-neutral-700 font-semibold uppercase text-white hover:bg-carnation-700 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-carnation-500"
        >
          {% icon_small "clipboard" %}
          <span>Copy table</span>
        </button>
        </div>
      <div class="relative">
        {# Scroll table button #}
        <button
          id="js_scroll_table_btn"
          class="p-2 bg-neutral-800 text-white text-2xl focus:outline-none focus:ring focus:ring-carnation-500 hover:bg-neutral-700 transition duration-300 ml-4 absolute right-3 top-1/2 transform -translate-y-1/2"
          aria-label="Scroll to see more of the table"
        >
          →
        </button>

        {# Data table #}
        <div class="mb-4">
          <div class="overflow-x-auto pb-4 bg-neutral-800 js_export_table_container min-h-[6rem] md:min-h-[8rem] lg:min-h-[10rem] border-l border-r border-b border-neutral-700" aria-live="polite">
            <table class="border-separate border-spacing-0 w-full table-fixed bg-white js_export_table" id="explore_table">
              <thead class="border-b border-neutral-700 bg-neutral-900 text-left text-xs font-medium uppercase tracking-wider text-white" id="export_table_head"></thead>
              <tbody class="text-xs md:text-sm text-neutral-900" id="export_table_body"></tbody>
              <tfoot class="text-xs md:text-sm bg-neutral-100 text-neutral-900" id="export_table_foot"></tfoot>
            </table>
          </div>
        </div>
      </div>
      {# <div class="flex justify-between" id="explore_export_container"></div> #}
      {# TODO: allow downloading of all data in CSV #}
      {# <div class="flex justify-between">
        <div class="text-right">
          <a href="/temp/bmgf_all-articles_from_2023-01-01-to-2023-10-04_on_2023-09-27.csv"
            download
            role="button"
            aria-label="Download full data as CSV"
            id="export_link"
            class="items-center space-x-2 px-4 py-2 text-base font-medium uppercase border border-neutral-100 text-neutral-100 bg-neutral-800 hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus:ring-1 focus:ring-carnation-400 duration-500 whitespace-nowrap inline-block">
              Download all <span class="js_export_type">data</span> (CSV)
          </a>
        </div>
      </div> #}
      {# Download CSV form #}
      <div id="download_csv_form_container" class="hidden">
        {% include 'partials/email-download-form.njk' %}
      </div>
      </div>
    </div>
  </div>
{% endcall %}
