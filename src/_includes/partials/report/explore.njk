{# Explore section #}
{% from "partials/report/section-wrapper.njk" import sectionWrapper %}

{% call sectionWrapper("explore", "Explore") %}
  {# Breakdown table options #}
  <nav aria-label="Explore views" aria-labelledby="explore-nav-title" class="flex flex-wrap items-center">
    <h3 id="explore-nav-title" class="sr-only">Explore views</h3>
    <ul id="explore_buttons" class="flex flex-wrap items-center gap-4 m-0 p-0 list-none">
      <li id="explore_see_more_item" class="list-none">
        <button class="inline-flex items-center rounded-md border border-neutral-300 bg-white px-4 py-1.5 text-sm font-medium text-neutral-700 shadow-sm transition-colors hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-1 focus-visible:ring-offset-white">
          <span>See more</span>
        </button>
      </li>
    </ul>
  </nav>

  <div class="mt-2 rounded-lg bg-neutral-100 p-4 shadow-md md:mt-4 md:p-6">
    {# Loading spinner #}
    <div
      class="fixed inset-0 z-50 flex justify-center items-center opacity-0 transition-opacity duration-300"
      id="explore_loading"
      aria-live="polite"
      aria-busy="true"
      >
      <div class="absolute inset-0 bg-neutral-900 bg-opacity-50"></div>
      <div class="loader ease-linear rounded-full border-8 border-t-8 border-carnation-200 border-t-carnation-500 h-12 w-12 z-10"></div>
      {# Visually hidden text for screen readers #}
      <div class="sr-only" id="loading_message">Loading, please wait.</div>
    </div>

    <div id="export_table">
      <header class="mb-4">
        <h3 class="mb-3 text-base font-semibold uppercase tracking-wide text-neutral-900 md:text-lg" aria-live="polite">
          <span class="inline-flex items-center gap-2">
            <i class="ph ph-note text-[18px] leading-none js-explore-heading-icon" aria-hidden="true"></i>
            <span class="report_sort_adjective">Top</span>
            <strong class="uppercase font-semibold explore_type">articles</strong>
          </span>
        </h3>
      </header>
      {# Filter by buttons styled as tabs #}
      <div id="explore_filter_field" class="mt-4 border-b border-neutral-200">
        <div
          id="explore_filters"
          role="tablist"
          aria-label="Explore data views"
          aria-orientation="horizontal"
          class="flex flex-wrap items-end gap-x-8 gap-y-3"
        ></div>
      </div>
      <div id="explore_view_panel" role="tabpanel" aria-labelledby="filter_is_paper">
        <div
          id="export_table_controls"
          role="toolbar"
          aria-label="Table controls"
          class="my-6 flex flex-wrap items-center justify-between gap-3 text-xs font-semibold uppercase text-neutral-600"
        >
        <div class="flex flex-wrap items-center gap-5 md:gap-7">
          <p id="explore_count_summary" class="flex items-center gap-1.5" aria-live="polite">
            <span id="explore_records_shown" class="inline-flex items-baseline"></span>
            / <span id="explore_count_total">0</span>
            <span id="explore_count_label">journal articles</span>
          </p>
          <form id="explore_display_style_field">
            <fieldset>
              <legend class="sr-only">Display values as</legend>
              <div class="inline-flex rounded-sm border border-neutral-300 bg-white p-0.5 transition-colors hover:border-neutral-400 focus-within:border-neutral-400">
                <input
                  id="display-style-percent"
                  type="radio"
                  name="explore-display-style"
                  value="percent"
                  class="sr-only peer/display-percent"
                  checked
                >
                <label
                  for="display-style-percent"
                  class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-900 peer-checked/display-percent:bg-neutral-900 peer-checked/display-percent:text-white peer-focus-visible/display-percent:ring-2 peer-focus-visible/display-percent:ring-carnation-400 peer-focus-visible/display-percent:ring-offset-1 peer-focus-visible/display-percent:ring-offset-white [&>i]:text-[1em]"
                >
                  Percent <span aria-hidden="true" class="inline-flex items-center self-center leading-none [&>i]:block [&>i]:text-[0.875em]">{% icon_small "percent" %}</span>
                </label>
                <input
                  id="display-style-count"
                  type="radio"
                  name="explore-display-style"
                  value="count"
                  class="sr-only peer/display-count"
                >
                <label
                  for="display-style-count"
                  class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-900 peer-checked/display-count:bg-neutral-900 peer-checked/display-count:text-white peer-focus-visible/display-count:ring-2 peer-focus-visible/display-count:ring-carnation-400 peer-focus-visible/display-count:ring-offset-1 peer-focus-visible/display-count:ring-offset-white [&>i]:text-[1em]"
                >
                  Count <span aria-hidden="true" class="inline-flex items-center self-center leading-none [&>i]:block [&>i]:text-[0.875em]">{% icon_small "hash" %}</span>
                </label>
              </div>
            </fieldset>
          </form>
        </div>
        <button
          id="explore_copy_clipboard"
          class="group inline-flex items-center self-start focus:outline-none focus-visible:ring-2 focus-visible:ring-carnation-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white"
        >
          <span class="inline-flex items-center gap-1.5 rounded-sm border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-neutral-700 transition-colors group-hover:border-neutral-400 group-hover:bg-neutral-100 group-hover:text-neutral-900 group-focus-visible:border-neutral-400 group-focus-visible:bg-neutral-100 group-focus-visible:text-neutral-900 [&>i]:shrink-0 [&>i]:text-[1em]">
            <span aria-hidden="true">{% icon_small "clipboard" %}</span>
            <span data-copy-label>Copy table</span>
          </span>
        </button>
        </div>
      <div class="relative">
        {# Scroll table button #}
        <button
          id="js_scroll_table_btn"
          class="absolute right-3 top-1/2 ml-4 -translate-y-1/2 border border-neutral-300 bg-white p-2 text-2xl text-neutral-700 transition duration-300 hover:bg-neutral-100 focus:outline-none focus:ring focus:ring-carnation-500"
          aria-label="Scroll to see more of the table"
        >
          →
        </button>

        {# Data table #}
        <div class="mb-4">
          <div class="js_export_table_container min-h-[6rem] overflow-x-auto rounded-lg border border-neutral-200 bg-white pb-4 md:min-h-[8rem] lg:min-h-[10rem]" aria-live="polite">
            <table class="js_export_table w-full table-fixed border-separate border-spacing-0 bg-white" id="explore_table">
              <thead class="border-b border-neutral-300 bg-neutral-200 text-left text-xs font-medium uppercase tracking-wider text-neutral-900" id="export_table_head"></thead>
              <tbody class="text-xs text-neutral-900 md:text-sm" id="export_table_body"></tbody>
              <tfoot class="bg-neutral-100 text-xs text-neutral-900 md:text-sm" id="export_table_foot"></tfoot>
            </table>
          </div>
        </div>
      </div>
      {# <div class="flex justify-between" id="explore_export_container"></div> #}
      {# TODO: allow downloading of all data in CSV #}
      {# <div class="flex justify-between">
        <div class="text-right">
          <a href="/temp/bmgf_all-articles_from_2023-01-01-to-2023-10-04_on_2023-09-27.csv"
            download
            role="button"
            aria-label="Download full data as CSV"
            id="export_link"
            class="items-center space-x-2 px-4 py-2 text-base font-medium uppercase border border-neutral-100 text-neutral-100 bg-neutral-800 hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus:ring-1 focus:ring-carnation-400 duration-500 whitespace-nowrap inline-block">
              Download all <span class="js_export_type">data</span> (CSV)
          </a>
        </div>
      </div> #}
      {# Download CSV form #}
      <div id="download_csv_form_container" class="hidden">
        {% include 'partials/email-download-form.njk' %}
      </div>
      </div>
    </div>
  </div>
{% endcall %}
